# AnchorScan (required for /scan AI diagnostic)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
# Keep false until WAF rate limits exist for /api/scan, /api/audit, and
# /api/build. The routes fail closed in hosted environments without an opt-in.
AI_PUBLIC_ENDPOINTS_ENABLED=false

# Private /api/anthropic proxy. Leave unset to keep the proxy disabled.
ANTHROPIC_PROXY_SECRET=replace-with-a-long-random-secret

# GitHub Integration
GITHUB_OWNER=adamtpang
GITHUB_TOKEN=ghp_your_github_token_here

# Revalidation
REVALIDATE_SECRET=your_revalidate_secret_here

# Stripe (for productized services)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUB_KEY=pk_test_your_stripe_public_key_here

# Email (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here

# Site Configuration
SITE_EMAIL=adam@anchormarianas.com

# Founder dashboard password (gate for /dashboard?key=...)
DASHBOARD_KEY=change-me

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
NEXT_PUBLIC_ANALYTICS_KEY=your_analytics_key_here
# AnchorScan review source. Free tier: 250 searches/month, no credit card.
# Get one at https://serpapi.com/users/sign_up
SERPAPI_API_KEY=
